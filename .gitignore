.DS_Store
.stow-backups/
Brewfile.lock.json

# Setup logs kept on failed runs
setup-*.log

# 1Password SSH git config -- never commit!
git/.gitconfig-1password-ssh

# Zsh generates these at runtime -- never commit them
zsh/.config/zsh/.zcompdump*
zsh/.config/zsh/.zcompcache/
zsh/.config/zsh/.zsh_history
zsh/.config/zsh/.zsh_sessions/

# Machine-specific zsh config (bootstrap from .zshrc.local.example)
zsh/.config/zsh/.zshrc.local
