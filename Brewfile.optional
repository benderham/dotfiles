# Optional Homebrew entries — picked interactively by
# scripts/install-brewfile.sh. Format (one per line):
#
#   brew:<name>              # description
#   cask:<name>              # description
#   tap:<owner>/<repo>       # description
#   mas:<App Name>=<id>      # description
#
# Lines starting with # and blank lines are ignored.

# -- CLI tools ----------------------------------------------------------------
brew:curl                                    # newer curl than the system one
brew:doggo                                   # modern DNS client
brew:gh                                      # GitHub CLI
brew:imagemagick                             # image conversion & manipulation
brew:lazygit                                 # git TUI
brew:trash                                   # move files to the Trash instead of rm
brew:wget                                    # file downloader
brew:yazi                                    # terminal file manager

# -- Fonts --------------------------------------------------------------------
cask:font-fira-code-nerd-font                # Fira Code (Nerd Font) — used by ghostty

# -- Apps ---------------------------------------------------------------------
cask:chatgpt                                 # ChatGPT desktop app
cask:claude                                  # Claude desktop app
cask:codex                                   # OpenAI Codex coding agent (CLI)
cask:firefox@developer-edition               # browser
cask:ghostty                                 # terminal emulator (config in ghostty/)
cask:google-chrome                           # browser
cask:insomnia                                # HTTP & GraphQL client
cask:logi-options+                           # Logitech mouse/keyboard settings
cask:logitune                                # Logitech webcam/headset settings
cask:notion                                  # notes & docs
cask:notion-calendar                         # calendar
cask:raycast                                 # launcher & productivity
cask:slack                                   # team chat
cask:visual-studio-code                      # editor (git core.editor = code --wait)
